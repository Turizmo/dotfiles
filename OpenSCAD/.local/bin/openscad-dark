#!/bin/bash
# Open a .scad file in the Flatpak OpenSCAD build showing only the 3D view,
# the toolbar and the Console. OpenSCAD is started through openscad-soft, which
# forces software OpenGL so the preview renders correctly in the VirtualBox VM.
#
# How it works (build 2026.10-TEST.fp, git 31f27b75):
#
#   * Dock visibility comes only from "window/state", which the MainWindow
#     constructor hands to QMainWindow::restoreState before the window is shown
#     (src/gui/MainWindow.cc:308-312, 4034-4048). The "view/hide*" settings are
#     written but never read.
#
#   * In that Qt state every dock is stored as 0xfb, its objectName, then one
#     flag byte; bit 0 is "visible" (qdockarealayout.cpp, StateFlagVisible).
#     Restore calls setVisible() from that bit, so a cleared bit means the dock
#     starts hidden, before the first paint.
#
# So before every launch, set those flag bytes in the saved state: Editor,
# Error Log, Font List, Color List and Animate hidden, Console shown. Every
# OpenSCAD process reads the state when it starts, so this also works when an
# OpenSCAD window is already open. OpenSCAD only writes the state back when its
# last window closes, and that write is overridden again on the next launch.
#
# This replaces closing the docks over D-Bus. A D-Bus toggle sent too early was
# lost or flipped a dock back on, and the D-Bus name belongs to the first
# process only, so a second window kept its Editor.
#
# With no saved state (fresh install, --reset-window-settings) the layout in
# ~/.local/share/openscad-dark/window-state is used as the starting point.

set -u

conf="$HOME/.var/app/org.openscad.OpenSCAD/config/OpenSCAD/OpenSCAD.conf"
fallback="$HOME/.local/share/openscad-dark/window-state"

mkdir -p "$(dirname "$conf")"
touch "$conf"

python3 -I - "$conf" "$fallback" <<'PY' || echo "openscad-dark: could not set the window layout" >&2
import re, sys

conf, fallback = sys.argv[1:]
want = {"editorDock": 0, "errorLogDock": 0, "fontListDock": 0,
        "colorListDock": 0, "animateDock": 0, "consoleDock": 1}

# QSettings writes the state as escaped text: each byte of the UTF-16 name is
# "\0" plus the character, and a character that could be read as a hex digit
# after an escape is itself written as "\xNN".
def name(dock):
    return "".join("\\0" + ("\\x%x" % ord(c) if c in "0123456789abcdefABCDEF" else c)
                   for c in dock)

# One escaped byte: \xN or \xNN, a C escape, or a plain character
byte = r"(\\x[0-9a-fA-F]{1,2}|\\[0abtnvfr\\]|[^\\])"

text = open(conf).read()
lines = text.split("\n")
idx = next((i for i, l in enumerate(lines) if l.startswith("state=")), None)
state = lines[idx][len("state="):] if idx is not None else open(fallback).read().strip()

for dock, visible in want.items():
    state, n = re.subn(re.escape(name(dock)) + byte,
                       lambda m: name(dock) + ("\\x1" if visible else "\\0"), state, count=1)
    if n != 1:
        sys.exit(f"openscad-dark: {dock} not found in window state")

if idx is not None:
    lines[idx] = "state=" + state
elif "[window]" in lines:
    lines.insert(lines.index("[window]") + 1, "state=" + state)
else:
    lines += ["[window]", "state=" + state, ""]
open(conf, "w").write("\n".join(lines))
PY

setsid nohup "$HOME/.local/bin/openscad-soft" "$1" >/dev/null 2>&1 &
